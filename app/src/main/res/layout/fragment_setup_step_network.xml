<?xml version="1.0" encoding="utf-8"?>
<!-- Setup step that creates the user's first network. The three radios map to the presets in
     NetworkPresets; the card below spells out what the selected one will actually create, so the
     addresses are visible before the network exists. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="32dp"
        android:paddingBottom="96dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/setup_step_icon_desc"
            android:src="@drawable/ic_large_network"
            tools:ignore="ImageContrastCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/setup_network_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/setup_network_desc"
            android:textSize="15sp"
            tools:ignore="VisualLintLongText" />

        <RadioGroup
            android:id="@+id/rg_net_preset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_net_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/setup_network_opt_wifi" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_net_linux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_network_opt_linux" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_net_gvisor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_network_opt_gvisor" />

        </RadioGroup>

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tv_net_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textSize="14sp"
                tools:text="Name: br-net0" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
