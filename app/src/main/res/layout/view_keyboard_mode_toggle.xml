<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard row of the display fab-menu header: one single-selection group choosing the typing
     surface. The Extra/FNx zone toggles are not here - they live on the keyboard itself, since
     they only mean anything while one is up. -->
<com.google.android.material.button.MaterialButtonToggleGroup
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_mode_group"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="10dp"
    app:selectionRequired="true"
    app:singleSelection="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mode_kb_none"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/keyboard_mode_none"
        android:minWidth="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:icon="@drawable/ic_keyboard_close"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mode_kb_system"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/keyboard_mode_system"
        android:minWidth="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:icon="@drawable/ic_keyboard"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mode_kb_laptop"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/keyboard_mode_laptop"
        android:minWidth="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:icon="@drawable/ic_keyboard_phy"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

</com.google.android.material.button.MaterialButtonToggleGroup>
