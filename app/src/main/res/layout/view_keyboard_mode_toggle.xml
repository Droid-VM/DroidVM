<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard row of the display fab-menu header: an extra-keys on/off toggle, then a
     single-selection group choosing the typing surface (system IME / physical keyboard);
     tapping the selected surface again deselects it (= no typing surface). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="10dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/extra_toggle_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggle_extra"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:contentDescription="@string/vnc_menu_extra_keys"
            app:icon="@drawable/ic_keyboard_esc"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <Space
        android:layout_width="8dp"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/surface_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_sys"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:contentDescription="@string/vnc_menu_keyboard"
            app:icon="@drawable/ic_keyboard"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_phy"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:contentDescription="@string/vnc_menu_phy_keyboard"
            app:icon="@drawable/ic_keyboard_phy"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>
