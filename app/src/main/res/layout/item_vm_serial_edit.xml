<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/create_vm_category_serial"
                android:src="@drawable/ic_serial_port"
                app:tint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radio_serial_console"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/edit_vm_serial_console"
                android:minWidth="0dp"
                android:minHeight="0dp"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/tv_serial_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="Serial 1 (SPCR)" />

            <cn.classfun.droidvm.ui.widgets.tools.PickerButtonWidget
                android:id="@+id/btn_serial_backend"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:title="@string/edit_vm_serial_backend"
                app:pb_mode="dialog" />

            <ImageButton
                android:id="@+id/btn_serial_delete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit_vm_serial_delete"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorError"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_serial_path"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/edit_vm_serial_path">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_serial_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp"
                tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_serial_usb_slot"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            tools:text="@string/edit_vm_serial_usb_slot" />

        <TextView
            android:id="@+id/tv_serial_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/edit_vm_serial_usb_note"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
