<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="16dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- Master switch stays pinned; everything it reveals scrolls, since the row
         list can reach the vCPU cap (64). Weight resolves against the height the
         dialog grants its custom view (same shape as dialog_boot_menu.xml). -->
    <cn.classfun.droidvm.ui.widgets.row.SwitchRowWidget
        android:id="@+id/sw_cpu_affinity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:icon="@drawable/ic_cpu"
        android:text="@string/create_vm_cpu_affinity" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/cpu_affinity_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Collapsible, because the row list below can reach 64 entries and
                 folding it is the only way to reach the topology section without
                 a long scroll. Its 72dp header indent lands on the same column as
                 the row titles inside it. -->
            <cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/create_vm_cpu_affinity_section_vcpus">

                <!-- One row per vCPU, added in Java. -->
                <LinearLayout
                    android:id="@+id/vcpu_rows_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer>

            <cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/create_vm_cpu_affinity_section_topology">

                <cn.classfun.droidvm.ui.widgets.row.SwitchRowWidget
                    android:id="@+id/sw_cpu_topology_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:icon="@drawable/ic_refresh_auto"
                    android:text="@string/create_vm_cpu_topology_auto" />

                <!-- Read-only preview of the derived values; shown when auto is on. -->
                <LinearLayout
                    android:id="@+id/cpu_topology_auto_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <cn.classfun.droidvm.ui.widgets.row.TextRowWidget
                        android:id="@+id/row_cpu_capacity_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:icon="@drawable/ic_speedometer"
                        android:text="@string/create_vm_cpu_capacity" />

                    <cn.classfun.droidvm.ui.widgets.row.TextRowWidget
                        android:id="@+id/row_cpu_cluster_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:icon="@drawable/ic_card_multiple"
                        android:text="@string/create_vm_cpu_cluster" />

                </LinearLayout>

                <!-- Manual capacity / cluster inputs; shown when auto is off. -->
                <LinearLayout
                    android:id="@+id/cpu_topology_manual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_cpu_capacity"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/create_vm_cpu_capacity_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_cpu_capacity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_cpu_clusters"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/create_vm_cpu_clusters_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_cpu_clusters"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
