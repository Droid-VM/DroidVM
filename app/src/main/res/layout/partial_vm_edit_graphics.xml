<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/create_vm_category_gpu">

        <cn.classfun.droidvm.ui.widgets.row.SwitchRowWidget
            android:id="@+id/sw_gpu_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_gpu"
            android:text="@string/create_vm_gpu_enabled" />

        <LinearLayout
            android:id="@+id/gpu_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <cn.classfun.droidvm.ui.widgets.row.ChooseRowWidget
                android:id="@+id/choose_gpu_backend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_drawing"
                android:text="@string/create_vm_gpu_backend" />

            <!-- The two axes rutabaga actually has, in order: what gets proxied (the capset /
                 context type), then which host driver serves it. The old single "GPU API" row
                 conflated them, so its options meant three different things depending on the
                 renderer above. -->
            <cn.classfun.droidvm.ui.widgets.row.ChooseRowWidget
                android:id="@+id/choose_gpu_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_application_cog"
                android:text="@string/create_vm_gpu_mode" />

            <cn.classfun.droidvm.ui.widgets.row.ChooseRowWidget
                android:id="@+id/choose_gpu_provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_memory"
                android:text="@string/create_vm_gpu_provider" />

            <cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer
                android:id="@+id/vram_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/create_vm_category_vram"
                app:cc_expanded="true">

                <cn.classfun.droidvm.ui.widgets.row.SwitchRowWidget
                    android:id="@+id/sw_gpu_udmabuf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_memory"
                    android:text="@string/create_vm_gpu_udmabuf" />

                <LinearLayout
                    android:id="@+id/vram_alloc_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_gpu_drm2kgsl_pool_mb"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="@string/create_vm_gpu_drm2kgsl_pool_mb">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_gpu_drm2kgsl_pool_mb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="1024"
                            tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_gpu_host_pool_mb"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="@string/create_vm_gpu_host_pool_mb">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_gpu_host_pool_mb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="256"
                            tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_gpu_venus_pool_mb"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="@string/create_vm_gpu_venus_pool_mb">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_gpu_venus_pool_mb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="256"
                            tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_gpu_guest_pool_mb"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="@string/create_vm_gpu_guest_pool_mb">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_gpu_guest_pool_mb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="1024"
                            tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <cn.classfun.droidvm.ui.widgets.row.SwitchRowWidget
                    android:id="@+id/sw_gpu_dynamic_vram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:icon="@drawable/ic_share"
                    android:text="@string/create_vm_gpu_dynamic_vram" />

                <LinearLayout
                    android:id="@+id/dynamic_vram_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical">

                    <!-- Host-alloc (gfxstream without udmabuf): host-visible memory past the
                         pre-alloc pool is runtime-SHARE'd, metered against the quota. -->
                    <LinearLayout
                        android:id="@+id/dynamic_vram_host_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_gpu_vram_quota_mb"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:hint="@string/create_vm_gpu_vram_quota_mb">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_gpu_vram_quota_mb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="2048"
                                tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_gpu_pool_blob_max_kb"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/create_vm_gpu_pool_blob_max_kb">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_gpu_pool_blob_max_kb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="4096"
                                tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Guest-alloc (udmabuf / drm2kgsl / venus): the guest pool is declared at
                         its full size but only the preallocation is SHARE'd at boot; the guest
                         grows and shrinks the rest at runtime, one memparcel per step. -->
                    <LinearLayout
                        android:id="@+id/dynamic_vram_guest_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_gpu_guest_prealloc_mb"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:hint="@string/create_vm_gpu_guest_prealloc_mb">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_gpu_guest_prealloc_mb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="1024"
                                tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_gpu_guest_step_mb"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:hint="@string/create_vm_gpu_guest_step_mb">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_gpu_guest_step_mb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="0"
                                tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_gpu_guest_max_grants"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/create_vm_gpu_guest_max_grants">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_gpu_guest_max_grants"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="0"
                                tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer>

        </LinearLayout>

    </cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer>

    <!-- Two screens, not one display with a backend picked for it: the simplefb device and the
         virtio-gpu device are independent, a VM can have both, and each carries the one exporter
         that watches it. The geometry above them is still VM-level; per-screen adjustables (the
         simplefb poll rate, the GPU screen's mode) are part of the screen definition landing,
         not of the bindings. -->
    <cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/create_vm_category_display">

        <LinearLayout
            android:id="@+id/display_geometry_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_display_width"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/create_vm_display_width">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_display_width"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="1280"
                    tools:ignore="HardcodedText,VisualLintTextFieldSize" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_display_height"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/create_vm_display_height">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_display_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="720"
                    tools:ignore="HardcodedText,VisualLintTextFieldSize" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_display_refresh_rate"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/create_vm_display_refresh_rate">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_display_refresh_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="30"
                    tools:ignore="HardcodedText,VisualLintTextFieldSize" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <include
            android:id="@+id/screen_gpu0_block"
            layout="@layout/partial_vm_screen_binding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <cn.classfun.droidvm.ui.widgets.row.ChooseRowWidget
            android:id="@+id/choose_display_blit_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_connection"
            android:text="@string/create_vm_display_blit_provider" />

        <LinearLayout
            android:id="@+id/display_dpi_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_display_dpi_h"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/create_vm_display_dpi_h">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_display_dpi_h"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="320"
                    tools:ignore="HardcodedText,VisualLintTextFieldSize" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_display_dpi_v"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/create_vm_display_dpi_v">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_display_dpi_v"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="320"
                    tools:ignore="HardcodedText,VisualLintTextFieldSize" />

            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <include
            android:id="@+id/screen_fb_block"
            layout="@layout/partial_vm_screen_binding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer>

    <!-- The GPU worker cpuset. The per-vCPU affinity that pairs with it lives in
         VMCpuAffinityDialog, reached from the CPU count field, since its rows are
         a function of that count. This block is not: it is a plain host cpuset. -->
    <cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/create_vm_category_gpu_cgroup">

        <cn.classfun.droidvm.ui.widgets.row.SwitchRowWidget
            android:id="@+id/sw_gpu_cgroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_gpu"
            android:text="@string/create_vm_gpu_cgroup" />

        <LinearLayout
            android:id="@+id/gpu_cgroup_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_gpu_cgroup_path"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/create_vm_gpu_cgroup_path_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_gpu_cgroup_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tapping opens a multi-choice host-core picker. -->
            <cn.classfun.droidvm.ui.widgets.row.TextRowWidget
                android:id="@+id/row_gpu_cgroup_cpus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_cpu"
                android:text="@string/create_vm_gpu_cgroup_cpus" />

            <!-- The virtio-gpu worker runs SCHED_FIFO when this is on; on gfxstream its
                 per-context render threads all inherit the same priority. It belongs inside the
                 cpuset block, as a peer of the core picker rather than a sibling of the block,
                 because the two only make sense together: confined to the picked cores, RT
                 threads contend for those and can spin-starve the vCPUs (priority inversion ->
                 low native-display present fps), which is a tradeoff; unconfined, the same
                 threads are free to take every core at a priority above everything else on the
                 phone, which is not. Off (the default) leaves them on normal scheduling. -->
            <cn.classfun.droidvm.ui.widgets.row.SwitchRowWidget
                android:id="@+id/sw_gpu_rt_prio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_application_cog"
                android:text="@string/create_vm_gpu_rt_prio" />

        </LinearLayout>

    </cn.classfun.droidvm.ui.widgets.container.CollapsibleContainer>

</LinearLayout>
