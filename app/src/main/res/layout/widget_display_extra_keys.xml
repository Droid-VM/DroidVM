<?xml version="1.0" encoding="utf-8"?>
<!-- The keyboard panel's shared zones, stacked bottom-up so the Main row never moves under the
     fingers: Extra on top, then FNx, then the Main row used in system-IME mode (the laptop
     keyboard is a separate view docked below this one and supplies its own Main). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/extra_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/extra_keys_background"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_esc"
                style="@style/ExtraKey"
                android:text="@string/key_esc"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_slash"
                style="@style/ExtraKey"
                android:text="@string/key_slash"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_dash"
                style="@style/ExtraKey"
                android:text="@string/key_dash"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_home"
                style="@style/ExtraKey"
                android:text="@string/key_home"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_up"
                style="@style/ExtraKey"
                android:text="@string/key_up"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_end"
                style="@style/ExtraKey"
                android:text="@string/key_end"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_pgup"
                style="@style/ExtraKey"
                android:text="@string/key_pgup"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/extra_keys_background"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_bksp"
                style="@style/ExtraKeyIcon"
                android:contentDescription="@string/key_desc_backspace"
                android:src="@drawable/ic_key_backspace"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_del"
                style="@style/ExtraKey"
                android:text="@string/key_del"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_ins"
                style="@style/ExtraKey"
                android:text="@string/key_ins"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_left"
                style="@style/ExtraKey"
                android:text="@string/key_left"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_down"
                style="@style/ExtraKey"
                android:text="@string/key_down"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_right"
                style="@style/ExtraKey"
                android:text="@string/key_right"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_pgdn"
                style="@style/ExtraKey"
                android:text="@string/key_pgdn"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/fnx_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/extra_keys_background"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_f1"
                style="@style/ExtraKey"
                android:text="@string/key_f1"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f2"
                style="@style/ExtraKey"
                android:text="@string/key_f2"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f3"
                style="@style/ExtraKey"
                android:text="@string/key_f3"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f4"
                style="@style/ExtraKey"
                android:text="@string/key_f4"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f5"
                style="@style/ExtraKey"
                android:text="@string/key_f5"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f6"
                style="@style/ExtraKey"
                android:text="@string/key_f6"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_prtsc"
                style="@style/ExtraKey"
                android:text="@string/key_prtsc"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/extra_keys_background"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_f7"
                style="@style/ExtraKey"
                android:text="@string/key_f7"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f8"
                style="@style/ExtraKey"
                android:text="@string/key_f8"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f9"
                style="@style/ExtraKey"
                android:text="@string/key_f9"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f10"
                style="@style/ExtraKey"
                android:text="@string/key_f10"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f11"
                style="@style/ExtraKey"
                android:text="@string/key_f11"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_f12"
                style="@style/ExtraKey"
                android:text="@string/key_f12"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btn_pause"
                style="@style/ExtraKey"
                android:text="@string/key_pause"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main zone for system-IME mode: the keys a soft keyboard has no way to send, plus the
         zone toggles and a button to summon the IME again after the system dismissed it. -->
    <LinearLayout
        android:id="@+id/system_main_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/extra_keys_background"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_tab"
            style="@style/ExtraKeyIcon"
            android:contentDescription="@string/key_desc_tab"
            android:src="@drawable/ic_key_tab"
            tools:ignore="TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btn_ctrl"
            style="@style/ExtraKey"
            android:text="@string/key_ctrl"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_shift"
            style="@style/ExtraKeyIcon"
            android:contentDescription="@string/key_desc_shift"
            android:src="@drawable/ic_key_shift"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_win"
            style="@style/ExtraKeyIcon"
            android:contentDescription="@string/key_desc_win"
            android:src="@drawable/ic_key_windows"
            tools:ignore="TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btn_alt"
            style="@style/ExtraKey"
            android:text="@string/key_alt"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_enter"
            style="@style/ExtraKeyIcon"
            android:contentDescription="@string/key_desc_enter"
            android:src="@drawable/ic_key_enter"
            tools:ignore="TouchTargetSizeCheck" />

        <!-- One slot, two mutually exclusive keys: with the IME up there is nothing to summon,
             so it becomes the Fn toggle; with the IME dismissed the toggle has no zone to sit
             above, so it becomes the button that brings the IME back. Keeping the row at seven
             keys is why they share. -->
        <Button
            android:id="@+id/btn_zone_fnx"
            style="@style/ExtraKey"
            android:text="@string/key_fnx"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btn_show_ime"
            style="@style/ExtraKeyIcon"
            android:contentDescription="@string/key_desc_ime"
            android:src="@drawable/ic_key_keyboard"
            android:visibility="gone"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

</merge>
