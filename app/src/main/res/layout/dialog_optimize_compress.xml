<?xml version="1.0" encoding="utf-8"?>
<!-- Optimize-compression prompt: one radio per crosvm-supported compression (populated from
     DiskCompress.CROSVM_SUPPORTED); "remember" persists the choice as the preferred-compression
     setting (changeable later in settings). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <RadioGroup
        android:id="@+id/compress_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/compress_remember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/disk_optimize_compress_remember" />

</LinearLayout>
