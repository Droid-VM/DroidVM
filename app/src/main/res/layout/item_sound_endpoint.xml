<?xml version="1.0" encoding="utf-8"?>
<!--
  One host endpoint on a virtio-snd card: the device it is pinned to, and what the guest should
  use it for. Which direction it carries is fixed rather than chosen: the label states it and the
  row sits in that direction's group, so changing it means removing the row and adding the other
  kind.

  What the endpoints of a card share (the buffer depth, and what to do about an underrun) is not
  here: those describe the device's queues rather than any one endpoint, so they live once on the
  card above.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_endpoint_mode"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        tools:text="@string/edit_vm_sound_mode_speaker" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_peripheral_host"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:minWidth="72dp"
        android:text="@string/edit_vm_peripheral_host_default"
        android:textSize="12sp"
        tools:ignore="TouchTargetSizeCheck,VisualLintButtonSize" />

    <!-- Same height as the device button beside it: a taller one would set the row's pitch and
         put these rows out of step with the ones on an Intel HDA card. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_endpoint_remove"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="@string/edit_vm_sound_endpoint_remove"
        app:icon="@drawable/ic_close"
        app:iconSize="18dp"
        tools:ignore="TouchTargetSizeCheck" />

</LinearLayout>
