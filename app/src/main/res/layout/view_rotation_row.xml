<?xml version="1.0" encoding="utf-8"?>
<!-- Rotation row of the display fab-menu header, styled like the input-mode and keyboard rows:
     turn the guest's picture left or right (Display orientation; the guest then turns its own UI,
     so Screen locks), and rotate the screen (Screen orientation; Android turns the activity,
     unlocked). The two turns are actions, unchecked again at once; the screen button is checked,
     with a lock, while the rotation is the guest's. -->
<com.google.android.material.button.MaterialButtonToggleGroup
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rotation_group"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="10dp"
    app:selectionRequired="false"
    app:singleSelection="false">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rotate_display_left"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:contentDescription="@string/display_rotate_left"
        app:icon="@drawable/ic_display_rotate_left"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rotate_display_right"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:contentDescription="@string/display_rotate_right"
        app:icon="@drawable/ic_display_rotate_right"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rotate_screen"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:contentDescription="@string/screen_rotate"
        app:icon="@drawable/ic_screen_rotation"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

</com.google.android.material.button.MaterialButtonToggleGroup>
