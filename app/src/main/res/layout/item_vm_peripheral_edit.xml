<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- header: device type + delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_peripheral_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/edit_vm_peripheral_type"
                android:src="@drawable/ic_speaker"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_peripheral_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textSize="14sp"
                tools:text="VirtIO Sound" />

            <ImageButton
                android:id="@+id/btn_peripheral_delete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit_vm_peripheral_delete"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorError"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

        <!-- unavailable notice (Intel HDA today) -->
        <TextView
            android:id="@+id/tv_peripheral_unavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/edit_vm_peripheral_unavailable"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- ===== VirtIO Sound: one card, endpoints grouped by direction ===== -->
        <LinearLayout
            android:id="@+id/group_virtio_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              Playback endpoints above the rule, capture ones below it. A row carries no direction
              of its own: which side of the rule it is on is its direction, and its label states
              which. The rule stays put when a group is empty, so an empty half still reads as a
              half rather than as a missing one.
            -->
            <LinearLayout
                android:id="@+id/sound_out_endpoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:id="@+id/sound_in_endpoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Adding an endpoint and the two card-wide settings: one row, because none of the
                 three belongs to any endpoint above. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sound_endpoint_add"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/edit_vm_sound_endpoint_add"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_add"
                    app:iconSize="18dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <cn.classfun.droidvm.ui.widgets.tools.PickerButtonWidget
                    android:id="@+id/btn_sound_buffer"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:title="@string/edit_vm_sound_buffer"
                    app:pb_mode="dialog" />

                <cn.classfun.droidvm.ui.widgets.tools.PickerButtonWidget
                    android:id="@+id/btn_sound_underrun"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:title="@string/edit_vm_sound_underrun"
                    app:pb_mode="dialog" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== Intel HDA: one card, both directions ===== -->
        <LinearLayout
            android:id="@+id/group_intel_hda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_vm_peripheral_host_output"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_hda_out"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="@string/edit_vm_peripheral_host_default"
                    android:textSize="12sp"
                    tools:ignore="TouchTargetSizeCheck,VisualLintButtonSize" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_vm_peripheral_host_input"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_hda_in"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="@string/edit_vm_peripheral_host_default"
                    android:textSize="12sp"
                    tools:ignore="TouchTargetSizeCheck,VisualLintButtonSize" />

            </LinearLayout>

        </LinearLayout>

        <!-- One camera device, one host camera: a virtio-media device registers exactly one
             /dev/videoX, so there is nothing here to add rows to. -->
        <LinearLayout
            android:id="@+id/group_virtio_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="@string/edit_vm_peripheral_host_camera"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_camera_device"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/host_camera_default"
                android:textSize="12sp"
                tools:ignore="TouchTargetSizeCheck,VisualLintButtonSize" />

        </LinearLayout>

        <!-- ===== xHCI USB controller: the ports it offers, and what the rules bind to it ===== -->
        <LinearLayout
            android:id="@+id/group_xhci"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Which controller this card is. Only worth saying when the VM has more than one:
                 that is the only case where a rule below could have meant the other. -->
            <TextView
                android:id="@+id/tv_xhci_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="xhci-0"
                tools:visibility="visible" />

            <!-- Says where the rows below actually live: they are the app-wide attach rules seen
                 through this controller, not a list this VM's config carries. -->
            <TextView
                android:id="@+id/tv_xhci_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/edit_vm_xhci_rules_note"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <!-- What passthrough being off means for this card: the rows below stay editable
                 and are still saved, they just do not run until the master switch is on. -->
            <TextView
                android:id="@+id/tv_xhci_passthrough_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/edit_vm_xhci_passthrough_off"
                android:textColor="?attr/colorError"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!--
              The four layers of the attach rules, in the order the daemon tries them. They are
              one list rather than four headed zones: a row states its own layer on the left, the
              way a sound endpoint states its direction, so a heading over an empty zone would be
              a title for nothing. The rules between them are drawn by bindXhci, and only where
              two layers that both have rows meet, so an empty layer costs no line.
            -->
            <LinearLayout
                android:id="@+id/xhci_zone_exact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <View
                android:id="@+id/xhci_divider_exact"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/colorOutlineVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/xhci_zone_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:id="@+id/xhci_divider_port"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/colorOutlineVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/xhci_zone_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:id="@+id/xhci_divider_device"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/colorOutlineVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/xhci_zone_any"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Adding a binding and the two controller-wide port counts: the VirtIO Sound row,
                 for the same reason: none of the three belongs to any row above. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_xhci_device_add"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/edit_vm_xhci_device_add"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_add"
                    app:iconSize="18dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <cn.classfun.droidvm.ui.widgets.tools.PickerButtonWidget
                    android:id="@+id/btn_xhci_usb2_ports"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:title="@string/edit_vm_xhci_usb2_ports"
                    app:pb_mode="dialog" />

                <cn.classfun.droidvm.ui.widgets.tools.PickerButtonWidget
                    android:id="@+id/btn_xhci_usb3_ports"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:title="@string/edit_vm_xhci_usb3_ports"
                    app:pb_mode="dialog" />

            </LinearLayout>

            <!-- Two lines rather than the card's shared warning below: both crosvm limits can be
                 true at once, and that one is rewritten by every host-endpoint bind. -->
            <TextView
                android:id="@+id/tv_xhci_warn_multi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/edit_vm_xhci_crosvm_one_only"
                android:textColor="?attr/colorError"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_xhci_warn_ports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/edit_vm_xhci_crosvm_ports_fixed"
                android:textColor="?attr/colorError"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_peripheral_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Not connected right now"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
