<?xml version="1.0" encoding="utf-8"?><!--
     What one rule matches on, and only the fields its zone stores. The exact zone shows both
     and the other two show one; the catch-all zone shows neither, so this view is not inflated
     for it at all and its dialog is the title and the buttons.

     Two dropdowns, not two buttons that open lists: the value is chosen from what is plugged in
     right now, which is the same shape of question the network and boot pages ask. The row
     widget carries its own 16dp, so the padding here is what is left to reach the dialog's.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <cn.classfun.droidvm.ui.widgets.row.DropdownRowWidget
        android:id="@+id/dd_edit_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/usb_rules_field_id" />

    <cn.classfun.droidvm.ui.widgets.row.DropdownRowWidget
        android:id="@+id/dd_edit_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/usb_rules_field_port" />

</LinearLayout>
