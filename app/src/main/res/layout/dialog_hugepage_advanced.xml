<?xml version="1.0" encoding="utf-8"?><!--
  One advanced settings.prop key. Deliberately raw: the header line is the
  module's own key=value readback, not prose - this dialog is reached by people
  reading the module documentation, and translating the keys would only put a
  second vocabulary between them and it. The warning below the field is the one
  piece of prose, because "lower than this device's default" is a judgement the
  raw numbers cannot make on their own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="16dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_adv_live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textIsSelectable="true"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_adv_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_adv_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="9" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_adv_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:textColor="?attr/colorError"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
