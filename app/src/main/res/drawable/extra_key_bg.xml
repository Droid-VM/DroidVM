<?xml version="1.0" encoding="utf-8"?>
<!-- Key background for the display keyboards: pressed lightens instantly (the key surface is
     always dark); on release the highlight fades back out instead of snapping. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="200">
    <item android:state_pressed="true" android:drawable="@color/extra_key_bg_pressed" />
    <item android:drawable="@android:color/transparent" />
</selector>
